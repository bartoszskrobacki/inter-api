# Application
PORT=3200
HOST=0.0.0.0  # on FreeBSD jail: set to the jail's IP address
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=inter_api

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
API_KEYS=your-api-key-1,your-api-key-2

# Facebook Integration
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Social Media Configuration (Optional)
SOCIAL_MEDIA_RETRY_ATTEMPTS=3
SOCIAL_MEDIA_RETRY_DELAY_MS=1000

# Instagram (TODO - future implementation)
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
